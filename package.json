				"command": "columbus.executeAll",
				"key": "ctrl+shift+enter",
				"when": "editorTextFocus && columbus.consoleActive && !suggestWidgetVisible"
			},
			{
				"command": "columbus.cancel",
				"key": "ctrl+f2",
				"mac": "cmd+f2",
				"when": "columbus.consoleRunning || columbus.redisConsoleRunning"
			},
			{
				"command": "columbus.editData",
				"key": "ctrl+down",
				"mac": "cmd+down",
				"when": "focusedView == columbus.explorer"
			},
			{
				"command": "columbus.tree.rename",
				"key": "f2",
				"when": "focusedView == columbus.explorer"
			},
			{
				"command": "columbus.tree.drop",
				"key": "ctrl+backspace",
				"mac": "cmd+backspace",
				"when": "focusedView == columbus.explorer"
			},
			{
				"command": "columbus.openConsole",
				"key": "ctrl+shift+l",
				"mac": "shift+cmd+l",
				"when": "focusedView == columbus.explorer"
			}
