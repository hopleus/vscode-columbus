{
	"name": "vscode-columbus",
	"displayName": "Columbus",
	"description": "A database client in the spirit of DataGrip: PostgreSQL, MySQL, MariaDB, SQLite, Redis, Valkey and Dragonfly with an editable data grid and SQL consoles that know your schema",
	"version": "0.1.0",
	"publisher": "hopleus",
	"icon": "resources/icon.png",
	"galleryBanner": {
		"color": "#1E1E1E",
		"theme": "dark"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/hopleus/vscode-columbus.git"
	},
	"homepage": "https://github.com/hopleus/vscode-columbus#readme",
	"bugs": {
		"url": "https://github.com/hopleus/vscode-columbus/issues"
	},
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"database",
		"sql",
		"postgresql",
		"mysql",
		"mariadb",
		"sqlite",
		"redis",
		"valkey",
		"dragonfly",
		"data grid",
		"sql client"
	],
	"main": "./out/extension.js",
	"activationEvents": [
		"onFileSystem:columbus-redis",
		"onWebviewPanel:columbus.dataEditor",
		"onWebviewPanel:columbus.redisKey",
		"onWebviewPanel:columbus.dataSource",
		"onWebviewPanel:columbus.result",
		"onLanguage:columbus-dragonfly",
		"onLanguage:columbus-mariadb",
		"onLanguage:columbus-mysql",
		"onLanguage:columbus-postgres",
		"onLanguage:columbus-redis",
		"onLanguage:columbus-sqlite",
		"onLanguage:columbus-valkey",
		"onLanguage:sql"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false,
			"description": "Columbus connects to databases and runs SQL."
		},
		"virtualWorkspaces": true
	},
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "columbus",
					"title": "Columbus",
					"icon": "resources/activity.svg"
				}
			],
			"panel": [
				{
					"id": "columbus-results",
					"title": "Columbus",
					"icon": "resources/activity.svg"
				}
			]
		},
		"views": {
			"columbus": [
				{
					"id": "columbus.explorer",
					"name": "Database Explorer"
				}
			],
			"columbus-results": [
				{
					"type": "webview",
					"id": "columbus.results",
					"name": "Results"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "columbus.explorer",
				"contents": "No data sources yet.\n[Add Data Source](command:columbus.addDataSource)"
			}
		],
		"commands": [
			{
				"command": "columbus.addDataSource",
				"title": "Add Data Source",
				"category": "Columbus",
				"icon": "$(add)"
			},
			{
				"command": "columbus.editDataSource",
				"title": "Data Source Properties",
				"category": "Columbus"
			},
			{
				"command": "columbus.removeDataSource",
				"title": "Remove Data Source",
				"category": "Columbus"
			},
			{
				"command": "columbus.refresh",
				"title": "Refresh",
				"category": "Columbus",
				"icon": "$(refresh)"
			},
			{
				"command": "columbus.openTable",
				"title": "Open Table",
				"category": "Columbus"
			},
			{
				"command": "columbus.openConsole",
				"title": "Open Query Console",
				"category": "Columbus",
				"icon": "$(terminal)"
			},
			{
				"command": "columbus.execute",
				"title": "Execute Statement",
				"category": "Columbus",
				"icon": "$(play)"
			},
			{
				"command": "columbus.cancel",
				"title": "Cancel Running Statement",
				"category": "Columbus",
				"icon": "$(debug-stop)"
			},
			{
				"command": "columbus.executeAll",
				"title": "Execute All Statements",
				"category": "Columbus",
				"icon": "$(run-all)"
			},
			{
				"command": "columbus.console.commit",
				"title": "Commit",
				"category": "Columbus",
				"icon": "$(check)",
				"enablement": "columbus.consoleTxOpen && !columbus.consoleRunning"
			},
			{
				"command": "columbus.console.rollback",
				"title": "Rollback",
				"category": "Columbus",
				"icon": "$(discard)",
				"enablement": "columbus.consoleTxOpen && !columbus.consoleRunning"
			},
			{
				"command": "columbus.console.toggleTransactionMode",
				"title": "Toggle Transaction Mode (Auto / Manual)",
				"category": "Columbus"
			},
			{
				"command": "columbus.console.chooseSchema",
				"title": "Choose Current Schema…",
				"category": "Columbus"
			},
			{
				"command": "columbus.console.chooseDatabase",
				"title": "Choose Console Database…",
				"category": "Columbus"
			},
			{
				"command": "columbus.clearResults",
				"title": "Clear Results",
				"category": "Columbus",
				"icon": "$(clear-all)"
			},
			{
				"command": "columbus.chooseConsole",
				"title": "Jump to Query Console…",
				"category": "Columbus",
				"icon": "$(terminal)"
			},
			{
				"command": "columbus.grid.edit",
				"title": "Edit",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.valueEditor",
				"title": "Open in Value Editor",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.setNull",
				"title": "Set NULL",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.setDefault",
				"title": "Set DEFAULT",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.setExpression",
				"title": "Set SQL Expression…",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.revert",
				"title": "Revert Selected",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.copy",
				"title": "Copy",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.copyCsv",
				"title": "CSV",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.copyTsv",
				"title": "TSV",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.copyJson",
				"title": "JSON",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.copySql",
				"title": "SQL Inserts",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.copyMarkdown",
				"title": "Markdown",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.paste",
				"title": "Paste",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.addRow",
				"title": "Add Row",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.cloneRow",
				"title": "Clone Row",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.deleteRows",
				"title": "Delete Rows",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.filterEquals",
				"title": "Equal to Value",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.filterNotEquals",
				"title": "Not Equal to Value",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.filterContains",
				"title": "Containing Value",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.filterNull",
				"title": "Is NULL",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.filterNotNull",
				"title": "Is Not NULL",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.filterGreater",
				"title": "Greater Than Value",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.filterLess",
				"title": "Less Than Value",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.clearFilter",
				"title": "Clear Filter",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.goTo",
				"title": "Go to Referenced Row",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.recordView",
				"title": "Show Record View",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.aggregate",
				"title": "Show Aggregate View",
				"category": "Columbus"
			},
			{
				"command": "columbus.grid.exportClipboard",
				"title": "Export to Clipboard",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.refresh",
				"title": "Refresh",
				"category": "Columbus",
				"icon": "$(refresh)"
			},
			{
				"command": "columbus.tree.chooseSchemas",
				"title": "Choose Schemas…",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.disconnect",
				"title": "Disconnect",
				"category": "Columbus"
			},
			{
				"command": "columbus.editData",
				"title": "Edit Data",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.newConsole",
				"title": "Query Console",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.newTable",
				"title": "Table",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.newView",
				"title": "View",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.newColumn",
				"title": "Column",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.newIndex",
				"title": "Index",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.ddl",
				"title": "Show DDL",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.select",
				"title": "SELECT Statement",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.insert",
				"title": "INSERT Statement",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.update",
				"title": "UPDATE Statement",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.delete",
				"title": "DELETE Statement",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.schemaDdl",
				"title": "Generate DDL",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.copyName",
				"title": "Copy Name",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.copyQualifiedName",
				"title": "Copy Qualified Name",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.export",
				"title": "Export Data…",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.rename",
				"title": "Rename…",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.truncate",
				"title": "Truncate…",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.objectDdl",
				"title": "Generate DDL",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.chooseDatabases",
				"title": "Choose Databases…",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.refreshMaterializedView",
				"title": "Refresh Materialized View…",
				"category": "Columbus"
			},
			{
				"command": "columbus.tree.drop",
				"title": "Drop…",
				"category": "Columbus"
			},
			{
				"command": "columbus.redis.openKey",
				"title": "Open Key",
				"category": "Columbus"
			},
			{
				"command": "columbus.redis.openConsole",
				"title": "Open Console",
				"category": "Columbus",
				"icon": "$(terminal)"
			},
			{
				"command": "columbus.redis.filterKeys",
				"title": "Filter Keys…",
				"category": "Columbus",
				"icon": "$(filter)"
			},
			{
				"command": "columbus.redis.newKey",
				"title": "New Key…",
				"category": "Columbus",
				"icon": "$(add)"
			},
			{
				"command": "columbus.redis.copyKey",
				"title": "Copy Key Name",
				"category": "Columbus"
			},
			{
				"command": "columbus.redis.renameKey",
				"title": "Rename Key…",
				"category": "Columbus"
			},
			{
				"command": "columbus.redis.expireKey",
				"title": "Set Time to Live…",
				"category": "Columbus"
			},
			{
				"command": "columbus.redis.deleteKey",
				"title": "Delete",
				"category": "Columbus"
			},
			{
				"command": "columbus.redis.chooseDatabase",
				"title": "Choose Console Database…",
				"category": "Columbus"
			},
			{
				"command": "columbus.redis.openAsText",
				"title": "Open as Text",
				"category": "Columbus"
			},
			{
				"command": "columbus.downloadDriver",
				"title": "Download Driver Files…",
				"category": "Columbus",
				"icon": "$(cloud-download)"
			},
			{
				"command": "columbus.manageDrivers",
				"title": "Manage Drivers…",
				"category": "Columbus",
				"icon": "$(extensions)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "columbus.addDataSource",
					"when": "view == columbus.explorer",
					"group": "navigation@1"
				},
				{
					"command": "columbus.chooseConsole",
					"when": "view == columbus.explorer",
					"group": "navigation@2"
				},
				{
					"command": "columbus.refresh",
					"when": "view == columbus.explorer",
					"group": "navigation@3"
				},
				{
					"command": "columbus.clearResults",
					"when": "view == columbus.results",
					"group": "navigation"
				},
				{
					"command": "columbus.manageDrivers",
					"when": "view == columbus.explorer",
					"group": "more@1"
				}
			],
			"view/item/context": [
				{
					"command": "columbus.editData",
					"when": "view == columbus.explorer && viewItem =~ /^(table|view|materializedView)$/",
					"group": "0_data@1"
				},
				{
					"submenu": "columbus.tree.new",
					"when": "view == columbus.explorer && viewItem =~ /^(source|schema|table)/",
					"group": "0_data@2"
				},
				{
					"command": "columbus.openConsole",
					"when": "view == columbus.explorer && viewItem =~ /^(source|redisSource|database$)/",
					"group": "0_data@3"
				},
				{
					"command": "columbus.tree.refresh",
					"when": "view == columbus.explorer && viewItem =~ /^(source|database|schema|table|view|materializedView|redisSource|redisDb|redisFolder)/",
					"group": "1_refresh@1"
				},
				{
					"command": "columbus.tree.disconnect",
					"when": "view == columbus.explorer && viewItem =~ /^(source|redisSource).*\\.connected(\\.|$)/",
					"group": "1_refresh@2"
				},
				{
					"command": "columbus.tree.copyName",
					"when": "view == columbus.explorer && viewItem =~ /^(database|schema|table|view|materializedView|column|primaryKey|key|foreignKey|index|routine|sequence|objectType|trigger|check|extension|role|tablespace)$/",
					"group": "2_copy@1"
				},
				{
					"command": "columbus.tree.copyQualifiedName",
					"when": "view == columbus.explorer && viewItem =~ /^(table|view|materializedView|column|routine|sequence|objectType)$/",
					"group": "2_copy@2"
				},
				{
					"submenu": "columbus.tree.scripts",
					"when": "view == columbus.explorer && viewItem =~ /^(table|view|materializedView)$/",
					"group": "3_scripts@1"
				},
				{
					"command": "columbus.tree.schemaDdl",
					"when": "view == columbus.explorer && viewItem == schema",
					"group": "3_scripts@2"
				},
				{
					"command": "columbus.tree.objectDdl",
					"when": "view == columbus.explorer && viewItem =~ /^(routine|sequence|objectType|trigger|check|extension|role|tablespace)$/",
					"group": "3_scripts@1"
				},
				{
					"command": "columbus.tree.export",
					"when": "view == columbus.explorer && viewItem =~ /^(table|view|materializedView)$/",
					"group": "3_scripts@3"
				},
				{
					"command": "columbus.tree.chooseDatabases",
					"when": "view == columbus.explorer && viewItem =~ /^source.*\\.databases/",
					"group": "4_properties@0"
				},
				{
					"command": "columbus.tree.chooseSchemas",
					"when": "view == columbus.explorer && viewItem =~ /^source/",
					"group": "4_properties@0"
				},
				{
					"command": "columbus.editDataSource",
					"when": "view == columbus.explorer && viewItem =~ /^(source|redisSource)\\.removable/",
					"group": "4_properties@1"
				},
				{
					"command": "columbus.tree.rename",
					"when": "view == columbus.explorer && viewItem =~ /^(table|view|materializedView|column)$/",
					"group": "5_modify@1"
				},
				{
					"command": "columbus.tree.truncate",
					"when": "view == columbus.explorer && viewItem == table",
					"group": "5_modify@2"
				},
				{
					"command": "columbus.tree.refreshMaterializedView",
					"when": "view == columbus.explorer && viewItem == materializedView",
					"group": "5_modify@3"
				},
				{
					"command": "columbus.tree.drop",
					"when": "view == columbus.explorer && viewItem =~ /^(table|view|materializedView|column|primaryKey|key|foreignKey|index|routine|sequence|objectType|trigger|check|extension|role|tablespace)$/",
					"group": "9_drop@1"
				},
				{
					"command": "columbus.removeDataSource",
					"when": "view == columbus.explorer && viewItem =~ /^(source|redisSource)\\.removable/",
					"group": "9_drop@2"
				},
				{
					"command": "columbus.redis.openConsole",
					"when": "view == columbus.explorer && viewItem == redisDb",
					"group": "0_data@1"
				},
				{
					"command": "columbus.redis.newKey",
					"when": "view == columbus.explorer && viewItem =~ /^(redisDb|redisFolder)$/",
					"group": "0_data@2"
				},
				{
					"command": "columbus.redis.filterKeys",
					"when": "view == columbus.explorer && viewItem == redisDb",
					"group": "0_data@3"
				},
				{
					"command": "columbus.redis.openKey",
					"when": "view == columbus.explorer && viewItem == redisKey",
					"group": "0_data@1"
				},
				{
					"command": "columbus.redis.copyKey",
					"when": "view == columbus.explorer && viewItem == redisKey",
					"group": "2_copy@1"
				},
				{
					"command": "columbus.redis.renameKey",
					"when": "view == columbus.explorer && viewItem == redisKey",
					"group": "3_modify@1"
				},
				{
					"command": "columbus.redis.expireKey",
					"when": "view == columbus.explorer && viewItem == redisKey",
					"group": "3_modify@2"
				},
				{
					"command": "columbus.redis.deleteKey",
					"when": "view == columbus.explorer && viewItem =~ /^(redisKey|redisFolder)$/",
					"group": "9_drop@1"
				},
				{
					"command": "columbus.redis.openAsText",
					"when": "view == columbus.explorer && viewItem == redisKey",
					"group": "0_data@2"
				}
			],
			"commandPalette": [
				{
					"command": "columbus.editDataSource",
					"when": "false"
				},
				{
					"command": "columbus.removeDataSource",
					"when": "false"
				},
				{
					"command": "columbus.openTable",
					"when": "false"
				},
				{
					"command": "columbus.execute",
					"when": "columbus.consoleActive || columbus.redisConsoleActive"
				},
				{
					"command": "columbus.cancel",
					"when": "columbus.consoleRunning || columbus.redisConsoleRunning"
				},
				{
					"command": "columbus.executeAll",
					"when": "columbus.consoleActive"
				},
				{
					"command": "columbus.console.commit",
					"when": "columbus.consoleActive"
				},
				{
					"command": "columbus.console.rollback",
					"when": "columbus.consoleActive"
				},
				{
					"command": "columbus.console.toggleTransactionMode",
					"when": "columbus.consoleActive"
				},
				{
					"command": "columbus.console.chooseSchema",
					"when": "columbus.consoleActive"
				},
				{
					"command": "columbus.console.chooseDatabase",
					"when": "columbus.consoleActive"
				},
				{
					"command": "columbus.clearResults",
					"when": "false"
				},
